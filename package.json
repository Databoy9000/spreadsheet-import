    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.0.1",
    "knip": "^6.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
