{
  "name": "@spotable/spreadsheet-import-core",
  "version": "0.5.3",
  "description": "Framework-agnostic spreadsheet import: parsing, column matching, validation and flow state. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./parsers": "./dist/parsers/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "cp ../../LICENSE LICENSE && node ../../tools/readme/generate.ts .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "spreadsheet",
    "import",
    "csv",
    "xlsx",
    "headless",
    "framework-agnostic",
    "validation"
  ],
  "peerDependencies": {
    "exceljs": "*",
    "xlsx": "*"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Databoy9000/spreadsheet-import.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Databoy9000/spreadsheet-import#readme",
  "bugs": {
    "url": "https://github.com/Databoy9000/spreadsheet-import/issues"
  },
  "author": "Spotable",
  "devDependencies": {
    "exceljs": "4.4.0"
  }
}
