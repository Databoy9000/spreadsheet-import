{
  "name": "@spreadsheet-import/ui-react",
  "version": "0.1.0",
  "description": "Tailwind reference UI for @spreadsheet-import/react. Copy it or import it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spreadsheet-import/core": "workspace:*",
    "@spreadsheet-import/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  }
}
