{
	"name": "@databoy9000/spreadsheet-import-react",
	"version": "0.2.0",
	"description": "Headless React hooks for spreadsheet import. Prop getters, no styling, no rendered markup.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@databoy9000/spreadsheet-import-core": "workspace:^"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Databoy9000/spreadsheet-import.git",
		"directory": "packages/react"
	},
	"homepage": "https://github.com/Databoy9000/spreadsheet-import#readme",
	"bugs": {
		"url": "https://github.com/Databoy9000/spreadsheet-import/issues"
	},
	"author": "Spotable"
}
