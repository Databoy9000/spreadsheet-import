{
  "name": "@spreadsheet-import/ui-shadcn",
  "version": "0.1.0",
  "description": "shadcn/ui flavoured import flow. Uses your theme tokens, ships as an npm package and as a shadcn registry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "registry"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry/*": "./registry/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "registry": "tsx scripts/build-registry.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@spreadsheet-import/core": "workspace:*",
    "@spreadsheet-import/react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  }
}
